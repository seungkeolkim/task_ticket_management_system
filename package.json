{
  "name": "task-ticket-management-system-frontend",
  "private": true,
  "scripts": {
    "build": "npm run build:javascript && npm run build:styles",
    "build:javascript": "esbuild frontend/tiptap-editor.js --bundle --minify --format=iife --target=es2020 --outfile=app/web/static/tiptap-editor.js",
    "build:styles": "esbuild frontend/tiptap-editor.css --bundle --minify --outfile=app/web/static/tiptap-editor.css"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/starter-kit": "3.31.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
