# Optional container environment overrides. Copy to .env only when needed.
# Configure server.port in config/application.toml so run_compose.sh can apply
# the same value to the application and Docker port publishing.

# Examples of nested setting overrides:
# TTMS__APP__LOG_LEVEL=DEBUG
# TTMS__LOGGING__MAX_SIZE_MB=100
# TTMS__LOGGING__BACKUP_COUNT=10
# TTMS__LOGGING__FILE_ENABLED=true
# TTMS__AUDIT__RETENTION_DAYS=60
# TTMS__AUDIT__CLEANUP_INTERVAL_HOURS=12
# TTMS__ATTACHMENTS__MAX_FILE_SIZE_MB=50
# TTMS__SESSION__LIFETIME_MINUTES=480

# Secrets must be provided by environment variables or a container secret.
# BOOTSTRAP_ADMIN_LOGIN_ID=admin
# BOOTSTRAP_ADMIN_DISPLAY_NAME=시스템 관리자
# BOOTSTRAP_ADMIN_PASSWORD=<initial-password-at-least-12-characters>
# Or use a mounted UTF-8 secret file instead of BOOTSTRAP_ADMIN_PASSWORD:
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
# Remove bootstrap credentials after initial setup.

# HTTPS deployment:
# TTMS__SESSION__COOKIE_SECURE=true
# TTMS__AUTH__PUBLIC_ORIGIN=https://tasks.example.com
