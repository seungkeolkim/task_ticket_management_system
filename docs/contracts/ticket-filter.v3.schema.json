{
  "$defs": {
    "CurrentUserRule": {
      "additionalProperties": false,
      "description": "필터를 적용하는 인증된 사용자를 참조한다.",
      "properties": {
        "kind": {
          "const": "current_user",
          "default": "current_user",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "CurrentUserRule",
      "type": "object"
    },
    "DayOffsetRule": {
      "additionalProperties": false,
      "description": "오늘에서 지정한 달력 일수 전후의 날짜를 참조한다.",
      "properties": {
        "kind": {
          "const": "day_offset",
          "default": "day_offset",
          "title": "Kind",
          "type": "string"
        },
        "days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "direction": {
          "enum": [
            "past",
            "future"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "days",
        "direction"
      ],
      "title": "DayOffsetRule",
      "type": "object"
    },
    "FilterCondition": {
      "additionalProperties": false,
      "description": "필드별 허용 연산자와 고정값을 검증하는 개별 조건이다.",
      "properties": {
        "kind": {
          "const": "condition",
          "default": "condition",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "enum": [
            "search",
            "type",
            "status",
            "priority",
            "epic",
            "parent",
            "creator",
            "assignee",
            "created_date",
            "updated_date",
            "due_date"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "in",
            "not_in",
            "contains",
            "not_contains",
            "is_empty",
            "is_not_empty",
            "on",
            "before",
            "after",
            "between"
          ],
          "title": "Operator",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "maxItems": 30,
          "title": "Values",
          "type": "array"
        },
        "rule": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "current_user": "#/$defs/CurrentUserRule",
                  "day_offset": "#/$defs/DayOffsetRule",
                  "relative_period": "#/$defs/RelativePeriodRule",
                  "today": "#/$defs/TodayRule",
                  "working_week": "#/$defs/WorkingWeekRule"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CurrentUserRule"
                },
                {
                  "$ref": "#/$defs/TodayRule"
                },
                {
                  "$ref": "#/$defs/DayOffsetRule"
                },
                {
                  "$ref": "#/$defs/RelativePeriodRule"
                },
                {
                  "$ref": "#/$defs/WorkingWeekRule"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "title": "FilterCondition",
      "type": "object"
    },
    "FilterGroup": {
      "additionalProperties": false,
      "description": "조건 또는 그룹의 결과를 AND/OR로 묶고 선택적으로 반전한다.",
      "properties": {
        "kind": {
          "const": "group",
          "default": "group",
          "title": "Kind",
          "type": "string"
        },
        "operator": {
          "default": "AND",
          "enum": [
            "AND",
            "OR"
          ],
          "title": "Operator",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "condition": "#/$defs/FilterCondition",
                "group": "#/$defs/FilterGroup"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FilterCondition"
              },
              {
                "$ref": "#/$defs/FilterGroup"
              }
            ]
          },
          "maxItems": 60,
          "title": "Children",
          "type": "array"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        }
      },
      "title": "FilterGroup",
      "type": "object"
    },
    "RelativePeriodRule": {
      "additionalProperties": false,
      "description": "오늘을 포함하는 총 N개 달력 날짜의 기간을 참조한다.",
      "properties": {
        "kind": {
          "const": "relative_period",
          "default": "relative_period",
          "title": "Kind",
          "type": "string"
        },
        "days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "direction": {
          "enum": [
            "past",
            "future"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "days",
        "direction"
      ],
      "title": "RelativePeriodRule",
      "type": "object"
    },
    "TodayRule": {
      "additionalProperties": false,
      "description": "요청 기준의 한국 날짜를 참조한다.",
      "properties": {
        "kind": {
          "const": "today",
          "default": "today",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "TodayRule",
      "type": "object"
    },
    "WorkingWeekRule": {
      "additionalProperties": false,
      "description": "이번 또는 지난 달력 주의 월요일부터 금요일까지를 참조한다.",
      "properties": {
        "kind": {
          "const": "working_week",
          "default": "working_week",
          "title": "Kind",
          "type": "string"
        },
        "week": {
          "enum": [
            "this",
            "last"
          ],
          "title": "Week",
          "type": "string"
        }
      },
      "required": [
        "week"
      ],
      "title": "WorkingWeekRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "목록·칸반·저장·URL에서 동일하게 사용하는 v3 조건 및 조회 설정이다.",
  "properties": {
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "expression": {
      "$ref": "#/$defs/FilterGroup"
    },
    "sort_by": {
      "default": "updated_at",
      "enum": [
        "created_at",
        "updated_at",
        "due_date",
        "priority",
        "number"
      ],
      "title": "Sort By",
      "type": "string"
    },
    "sort_direction": {
      "default": "desc",
      "enum": [
        "asc",
        "desc"
      ],
      "title": "Sort Direction",
      "type": "string"
    },
    "page_size": {
      "default": 20,
      "enum": [
        10,
        20,
        50
      ],
      "title": "Page Size",
      "type": "integer"
    }
  },
  "title": "TicketFilter",
  "type": "object"
}
