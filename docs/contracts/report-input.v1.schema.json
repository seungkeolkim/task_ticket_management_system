{
  "$defs": {
    "CurrentUserRule": {
      "additionalProperties": false,
      "description": "필터를 적용하는 인증된 사용자를 참조한다.",
      "properties": {
        "kind": {
          "const": "current_user",
          "default": "current_user",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "CurrentUserRule",
      "type": "object"
    },
    "DateRangeRule": {
      "additionalProperties": false,
      "description": "시작과 종료를 각각 고정 또는 동적 단일 날짜로 지정한다.",
      "properties": {
        "kind": {
          "const": "date_range",
          "default": "date_range",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "discriminator": {
            "mapping": {
              "day_offset": "#/$defs/DayOffsetRule",
              "fixed_date": "#/$defs/FixedDateAnchor",
              "today": "#/$defs/TodayRule",
              "week_day": "#/$defs/WeekdayRule"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedDateAnchor"
            },
            {
              "$ref": "#/$defs/TodayRule"
            },
            {
              "$ref": "#/$defs/DayOffsetRule"
            },
            {
              "$ref": "#/$defs/WeekdayRule"
            }
          ],
          "title": "Start"
        },
        "end": {
          "discriminator": {
            "mapping": {
              "day_offset": "#/$defs/DayOffsetRule",
              "fixed_date": "#/$defs/FixedDateAnchor",
              "today": "#/$defs/TodayRule",
              "week_day": "#/$defs/WeekdayRule"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedDateAnchor"
            },
            {
              "$ref": "#/$defs/TodayRule"
            },
            {
              "$ref": "#/$defs/DayOffsetRule"
            },
            {
              "$ref": "#/$defs/WeekdayRule"
            }
          ],
          "title": "End"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRangeRule",
      "type": "object"
    },
    "DayOffsetRule": {
      "additionalProperties": false,
      "description": "오늘에서 지정한 달력 일수 전후의 날짜를 참조한다.",
      "properties": {
        "kind": {
          "const": "day_offset",
          "default": "day_offset",
          "title": "Kind",
          "type": "string"
        },
        "days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "direction": {
          "enum": [
            "past",
            "future"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "days",
        "direction"
      ],
      "title": "DayOffsetRule",
      "type": "object"
    },
    "FieldChange": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/JsonValue"
        },
        "after": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "field",
        "before",
        "after"
      ],
      "title": "FieldChange",
      "type": "object"
    },
    "FilterCondition": {
      "additionalProperties": false,
      "description": "필드별 허용 연산자와 고정값을 검증하는 개별 조건이다.",
      "properties": {
        "kind": {
          "const": "condition",
          "default": "condition",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "enum": [
            "search",
            "type",
            "status",
            "priority",
            "epic",
            "parent",
            "creator",
            "assignee",
            "created_date",
            "updated_date",
            "due_date"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "in",
            "not_in",
            "contains",
            "not_contains",
            "is_empty",
            "is_not_empty",
            "on",
            "before",
            "after",
            "between"
          ],
          "title": "Operator",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "maxItems": 30,
          "title": "Values",
          "type": "array"
        },
        "rule": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "current_user": "#/$defs/CurrentUserRule",
                  "date_range": "#/$defs/DateRangeRule",
                  "day_offset": "#/$defs/DayOffsetRule",
                  "relative_period": "#/$defs/RelativePeriodRule",
                  "today": "#/$defs/TodayRule",
                  "week_day": "#/$defs/WeekdayRule",
                  "working_week": "#/$defs/WorkingWeekRule"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CurrentUserRule"
                },
                {
                  "$ref": "#/$defs/TodayRule"
                },
                {
                  "$ref": "#/$defs/DayOffsetRule"
                },
                {
                  "$ref": "#/$defs/RelativePeriodRule"
                },
                {
                  "$ref": "#/$defs/WorkingWeekRule"
                },
                {
                  "$ref": "#/$defs/WeekdayRule"
                },
                {
                  "$ref": "#/$defs/DateRangeRule"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "title": "FilterCondition",
      "type": "object"
    },
    "FilterGroup": {
      "additionalProperties": false,
      "description": "조건 또는 그룹의 결과를 AND/OR로 묶고 선택적으로 반전한다.",
      "properties": {
        "kind": {
          "const": "group",
          "default": "group",
          "title": "Kind",
          "type": "string"
        },
        "operator": {
          "default": "AND",
          "enum": [
            "AND",
            "OR"
          ],
          "title": "Operator",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "condition": "#/$defs/FilterCondition",
                "group": "#/$defs/FilterGroup"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FilterCondition"
              },
              {
                "$ref": "#/$defs/FilterGroup"
              }
            ]
          },
          "maxItems": 60,
          "title": "Children",
          "type": "array"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        }
      },
      "title": "FilterGroup",
      "type": "object"
    },
    "FixedDateAnchor": {
      "additionalProperties": false,
      "description": "직접 지정한 날짜를 기간의 시작 또는 종료 경계로 사용한다.",
      "properties": {
        "kind": {
          "const": "fixed_date",
          "default": "fixed_date",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "FixedDateAnchor",
      "type": "object"
    },
    "HistoryEventType": {
      "enum": [
        "CREATED",
        "UPDATED",
        "STATUS_CHANGED",
        "RELATION_CHANGED",
        "CONTENT_CHANGED",
        "DELETED",
        "RESTORED"
      ],
      "title": "HistoryEventType",
      "type": "string"
    },
    "JsonValue": {},
    "Priority": {
      "enum": [
        "TRIVIAL",
        "MINOR",
        "MAJOR",
        "CRITICAL",
        "BLOCKER"
      ],
      "title": "Priority",
      "type": "string"
    },
    "RelationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "source_ticket_key": {
          "title": "Source Ticket Key",
          "type": "string"
        },
        "target_ticket_key": {
          "title": "Target Ticket Key",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/RelationType"
        },
        "dependency_kind": {
          "anyOf": [
            {
              "enum": [
                "FS",
                "SS",
                "FF",
                "SF"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Kind"
        },
        "lag_days": {
          "default": 0,
          "title": "Lag Days",
          "type": "integer"
        }
      },
      "required": [
        "source_ticket_key",
        "target_ticket_key",
        "relation_type"
      ],
      "title": "RelationSnapshot",
      "type": "object"
    },
    "RelationType": {
      "enum": [
        "RELATED",
        "DEPENDS_ON"
      ],
      "title": "RelationType",
      "type": "string"
    },
    "RelativePeriodRule": {
      "additionalProperties": false,
      "description": "오늘을 포함하는 총 N개 달력 날짜의 기간을 참조한다.",
      "properties": {
        "kind": {
          "const": "relative_period",
          "default": "relative_period",
          "title": "Kind",
          "type": "string"
        },
        "days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "direction": {
          "enum": [
            "past",
            "future"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "days",
        "direction"
      ],
      "title": "RelativePeriodRule",
      "type": "object"
    },
    "ReportPeriod": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "default": "Asia/Seoul",
          "maxLength": 100,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ReportPeriod",
      "type": "object"
    },
    "ReportTicketEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^ticket:[A-Za-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "ticket_key": {
          "title": "Ticket Key",
          "type": "string"
        },
        "project_id": {
          "exclusiveMinimum": 0,
          "title": "Project Id",
          "type": "integer"
        },
        "state_at_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/TicketState"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_at_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/TicketState"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "items": {
            "$ref": "#/$defs/TicketEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "ticket_key",
        "project_id",
        "state_at_start",
        "state_at_end"
      ],
      "title": "ReportTicketEvidence",
      "type": "object"
    },
    "TicketCustomField": {
      "additionalProperties": false,
      "description": "재사용 정의 없이 하나의 ticket에 속하는 타입 구분 가능한 값이다.",
      "properties": {
        "field_id": {
          "format": "uuid",
          "title": "Field Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "field_type": {
          "const": "TEXT",
          "default": "TEXT",
          "title": "Field Type",
          "type": "string"
        },
        "value": {
          "default": "",
          "maxLength": 10000,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "TicketCustomField",
      "type": "object"
    },
    "TicketEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "event_key": {
          "format": "uuid",
          "title": "Event Key",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "ticket_key": {
          "title": "Ticket Key",
          "type": "string"
        },
        "project_id": {
          "exclusiveMinimum": 0,
          "title": "Project Id",
          "type": "integer"
        },
        "ticket_version": {
          "exclusiveMinimum": 0,
          "title": "Ticket Version",
          "type": "integer"
        },
        "event_type": {
          "$ref": "#/$defs/HistoryEventType"
        },
        "actor_id": {
          "exclusiveMinimum": 0,
          "title": "Actor Id",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "before_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TicketState"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_state": {
          "$ref": "#/$defs/TicketState"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/FieldChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "event_key",
        "operation_id",
        "ticket_key",
        "project_id",
        "ticket_version",
        "event_type",
        "actor_id",
        "occurred_at",
        "before_state",
        "after_state",
        "changes"
      ],
      "title": "TicketEvent",
      "type": "object"
    },
    "TicketFilter": {
      "additionalProperties": false,
      "description": "목록·칸반·저장·URL에서 동일하게 사용하는 v4 조건 및 조회 설정이다.",
      "properties": {
        "schema_version": {
          "const": 4,
          "default": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "expression": {
          "$ref": "#/$defs/FilterGroup"
        },
        "sort_by": {
          "default": "updated_at",
          "enum": [
            "created_at",
            "updated_at",
            "due_date",
            "priority",
            "number"
          ],
          "title": "Sort By",
          "type": "string"
        },
        "sort_direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Sort Direction",
          "type": "string"
        },
        "page_size": {
          "default": 20,
          "enum": [
            10,
            20,
            50
          ],
          "title": "Page Size",
          "type": "integer"
        }
      },
      "title": "TicketFilter",
      "type": "object"
    },
    "TicketState": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Labels",
          "type": "array"
        },
        "custom_fields": {
          "items": {
            "$ref": "#/$defs/TicketCustomField"
          },
          "maxItems": 30,
          "title": "Custom Fields",
          "type": "array"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "ticket_key": {
          "title": "Ticket Key",
          "type": "string"
        },
        "project_id": {
          "exclusiveMinimum": 0,
          "title": "Project Id",
          "type": "integer"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/TicketType"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description_document": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Description Document",
          "type": "object"
        },
        "body_schema_version": {
          "default": 2,
          "enum": [
            2,
            3
          ],
          "title": "Body Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/TicketStatus"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "parent_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Key"
        },
        "creator_id": {
          "exclusiveMinimum": 0,
          "title": "Creator Id",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "assignee_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignee Id"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "planned_start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Start Date"
        },
        "planned_end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned End Date"
        },
        "actual_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "cancelled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancelled At"
        },
        "progress_percent": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Progress Percent",
          "type": "integer"
        },
        "is_milestone": {
          "default": false,
          "title": "Is Milestone",
          "type": "boolean"
        },
        "sort_order": {
          "default": "0",
          "title": "Sort Order",
          "type": "string"
        },
        "deleted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted At"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationSnapshot"
          },
          "title": "Relations",
          "type": "array"
        }
      },
      "required": [
        "ticket_key",
        "project_id",
        "version",
        "type",
        "title",
        "status",
        "priority",
        "creator_id",
        "created_at",
        "updated_at"
      ],
      "title": "TicketState",
      "type": "object"
    },
    "TicketStatus": {
      "enum": [
        "TODO",
        "IN_PROGRESS",
        "DONE",
        "ON_HOLD",
        "CANCELLED"
      ],
      "title": "TicketStatus",
      "type": "string"
    },
    "TicketType": {
      "enum": [
        "EPIC",
        "TASK",
        "SUBTASK"
      ],
      "title": "TicketType",
      "type": "string"
    },
    "TodayRule": {
      "additionalProperties": false,
      "description": "요청 기준의 한국 날짜를 참조한다.",
      "properties": {
        "kind": {
          "const": "today",
          "default": "today",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "TodayRule",
      "type": "object"
    },
    "WeekdayRule": {
      "additionalProperties": false,
      "description": "월요일부터 시작하는 이번 또는 지난 달력 주의 특정 요일을 참조한다.",
      "properties": {
        "kind": {
          "const": "week_day",
          "default": "week_day",
          "title": "Kind",
          "type": "string"
        },
        "week": {
          "enum": [
            "this",
            "last"
          ],
          "title": "Week",
          "type": "string"
        },
        "weekday": {
          "maximum": 6,
          "minimum": 0,
          "title": "Weekday",
          "type": "integer"
        }
      },
      "required": [
        "week",
        "weekday"
      ],
      "title": "WeekdayRule",
      "type": "object"
    },
    "WorkingWeekRule": {
      "additionalProperties": false,
      "description": "이번 또는 지난 달력 주의 월요일부터 금요일까지를 참조한다.",
