{
  "$defs": {
    "CurrentUserRule": {
      "additionalProperties": false,
      "description": "필터를 적용하는 인증된 사용자를 참조한다.",
      "properties": {
        "kind": {
          "const": "current_user",
          "default": "current_user",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "CurrentUserRule",
      "type": "object"
    },
    "DateRangeRule": {
      "additionalProperties": false,
      "description": "시작과 종료를 각각 고정 또는 동적 단일 날짜로 지정한다.",
      "properties": {
        "kind": {
          "const": "date_range",
          "default": "date_range",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "discriminator": {
            "mapping": {
              "day_offset": "#/$defs/DayOffsetRule",
              "fixed_date": "#/$defs/FixedDateAnchor",
              "today": "#/$defs/TodayRule",
              "week_day": "#/$defs/WeekdayRule"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedDateAnchor"
            },
            {
              "$ref": "#/$defs/TodayRule"
            },
            {
              "$ref": "#/$defs/DayOffsetRule"
            },
            {
              "$ref": "#/$defs/WeekdayRule"
            }
          ],
          "title": "Start"
        },
        "end": {
          "discriminator": {
            "mapping": {
              "day_offset": "#/$defs/DayOffsetRule",
              "fixed_date": "#/$defs/FixedDateAnchor",
              "today": "#/$defs/TodayRule",
              "week_day": "#/$defs/WeekdayRule"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedDateAnchor"
            },
            {
              "$ref": "#/$defs/TodayRule"
            },
            {
              "$ref": "#/$defs/DayOffsetRule"
            },
            {
              "$ref": "#/$defs/WeekdayRule"
            }
          ],
          "title": "End"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRangeRule",
      "type": "object"
    },
    "DayOffsetRule": {
      "additionalProperties": false,
      "description": "오늘에서 지정한 달력 일수 전후의 날짜를 참조한다.",
      "properties": {
        "kind": {
          "const": "day_offset",
          "default": "day_offset",
          "title": "Kind",
          "type": "string"
        },
        "days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "direction": {
          "enum": [
            "past",
            "future"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "days",
        "direction"
      ],
      "title": "DayOffsetRule",
      "type": "object"
    },
    "FilterCondition": {
      "additionalProperties": false,
      "description": "필드별 허용 연산자와 고정값을 검증하는 개별 조건이다.",
      "properties": {
        "kind": {
          "const": "condition",
          "default": "condition",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "enum": [
            "search",
            "type",
            "status",
            "priority",
            "epic",
            "parent",
            "creator",
            "assignee",
            "created_date",
            "updated_date",
            "due_date"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "in",
            "not_in",
            "contains",
            "not_contains",
            "is_empty",
            "is_not_empty",
            "on",
            "before",
            "after",
            "between"
          ],
          "title": "Operator",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "maxItems": 30,
          "title": "Values",
          "type": "array"
        },
        "rule": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "current_user": "#/$defs/CurrentUserRule",
                  "date_range": "#/$defs/DateRangeRule",
                  "day_offset": "#/$defs/DayOffsetRule",
                  "relative_period": "#/$defs/RelativePeriodRule",
                  "today": "#/$defs/TodayRule",
                  "week_day": "#/$defs/WeekdayRule",
                  "working_week": "#/$defs/WorkingWeekRule"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CurrentUserRule"
                },
                {
                  "$ref": "#/$defs/TodayRule"
                },
                {
                  "$ref": "#/$defs/DayOffsetRule"
                },
                {
                  "$ref": "#/$defs/RelativePeriodRule"
                },
                {
                  "$ref": "#/$defs/WorkingWeekRule"
                },
                {
                  "$ref": "#/$defs/WeekdayRule"
                },
                {
                  "$ref": "#/$defs/DateRangeRule"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "title": "FilterCondition",
      "type": "object"
    },
    "FilterGroup": {
      "additionalProperties": false,
      "description": "조건 또는 그룹의 결과를 AND/OR로 묶고 선택적으로 반전한다.",
      "properties": {
        "kind": {
          "const": "group",
          "default": "group",
          "title": "Kind",
          "type": "string"
        },
        "operator": {
          "default": "AND",
          "enum": [
            "AND",
            "OR"
          ],
          "title": "Operator",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "condition": "#/$defs/FilterCondition",
                "group": "#/$defs/FilterGroup"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FilterCondition"
              },
              {
                "$ref": "#/$defs/FilterGroup"
              }
            ]
          },
          "maxItems": 60,
          "title": "Children",
          "type": "array"
        },
        "negated": {
          "default": false,
          "title": "Negated",
          "type": "boolean"
        }
      },
      "title": "FilterGroup",
      "type": "object"
    },
    "FixedDateAnchor": {
      "additionalProperties": false,
      "description": "직접 지정한 날짜를 기간의 시작 또는 종료 경계로 사용한다.",
      "properties": {
        "kind": {
          "const": "fixed_date",
          "default": "fixed_date",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "FixedDateAnchor",
      "type": "object"
    },
    "RelativePeriodRule": {
      "additionalProperties": false,
      "description": "오늘을 포함하는 총 N개 달력 날짜의 기간을 참조한다.",
      "properties": {
        "kind": {
          "const": "relative_period",
          "default": "relative_period",
          "title": "Kind",
          "type": "string"
        },
        "days": {
          "maximum": 3650,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "direction": {
          "enum": [
            "past",
            "future"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "days",
        "direction"
      ],
      "title": "RelativePeriodRule",
      "type": "object"
    },
    "TodayRule": {
      "additionalProperties": false,
      "description": "요청 기준의 한국 날짜를 참조한다.",
      "properties": {
        "kind": {
          "const": "today",
          "default": "today",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "TodayRule",
      "type": "object"
    },
    "WeekdayRule": {
      "additionalProperties": false,
      "description": "월요일부터 시작하는 이번 또는 지난 달력 주의 특정 요일을 참조한다.",
      "properties": {
        "kind": {
          "const": "week_day",
          "default": "week_day",
          "title": "Kind",
          "type": "string"
        },
        "week": {
          "enum": [
            "this",
            "last"
          ],
          "title": "Week",
          "type": "string"
        },
        "weekday": {
          "maximum": 6,
          "minimum": 0,
          "title": "Weekday",
          "type": "integer"
        }
      },
      "required": [
        "week",
        "weekday"
      ],
      "title": "WeekdayRule",
      "type": "object"
    },
    "WorkingWeekRule": {
      "additionalProperties": false,
      "description": "이번 또는 지난 달력 주의 월요일부터 금요일까지를 참조한다.",
      "properties": {
        "kind": {
          "const": "working_week",
          "default": "working_week",
          "title": "Kind",
          "type": "string"
        },
        "week": {
          "enum": [
            "this",
            "last"
          ],
          "title": "Week",
          "type": "string"
        }
      },
      "required": [
        "week"
      ],
      "title": "WorkingWeekRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "목록·칸반·저장·URL에서 동일하게 사용하는 v4 조건 및 조회 설정이다.",
  "properties": {
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "expression": {
      "$ref": "#/$defs/FilterGroup"
    },
    "sort_by": {
      "default": "updated_at",
      "enum": [
        "created_at",
        "updated_at",
        "due_date",
        "priority",
        "number"
      ],
      "title": "Sort By",
      "type": "string"
    },
    "sort_direction": {
      "default": "desc",
      "enum": [
        "asc",
        "desc"
      ],
      "title": "Sort Direction",
      "type": "string"
    },
    "page_size": {
      "default": 20,
      "enum": [
        10,
        20,
        50
      ],
      "title": "Page Size",
      "type": "integer"
    }
  },
  "title": "TicketFilter",
  "type": "object"
}
