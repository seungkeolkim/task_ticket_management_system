# 선택 사항: config/application.toml로 복사해 호스트별 설정을 변경합니다.
# 파일이 없어도 아래 값과 동일한 애플리케이션 기본값을 사용합니다.

[app]
name = "Task Ticket Management System"
environment = "development"
debug = false
timezone = "Asia/Seoul"
log_level = "INFO"

[server]
host = "0.0.0.0"
port = 8000
workers = 1

[storage]
data_root = "./data"
database_dir = "database"
attachments_dir = "attachments"
backups_dir = "backups"
logs_dir = "logs"

[logging]
file_enabled = true
file_name = "application.log"
max_size_mb = 100
backup_count = 10

[database]
# When omitted, SQLite is created under storage.data_root/database_dir.
# url = "postgresql+psycopg://user:password@database/task_tickets"
echo = false
pool_pre_ping = true

[attachments]
max_file_size_mb = 25
deleted_file_retention_days = 30
allowed_extensions = ["png", "jpg", "jpeg", "gif", "webp", "pdf", "txt", "md", "csv", "docx", "xlsx", "pptx", "zip"]
blocked_extensions = ["exe", "com", "bat", "cmd", "ps1", "sh", "js", "vbs", "msi", "dll", "scr"]

[attachments.allowed_media_types]
png = ["image/png"]
jpg = ["image/jpeg"]
jpeg = ["image/jpeg"]
gif = ["image/gif"]
webp = ["image/webp"]
pdf = ["application/pdf"]
txt = ["text/plain"]
md = ["text/markdown", "text/plain"]
csv = ["text/csv", "text/plain", "application/csv"]
docx = ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
xlsx = ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]
pptx = ["application/vnd.openxmlformats-officedocument.presentationml.presentation"]
zip = ["application/zip", "application/x-zip-compressed"]

[audit]
retention_days = 30
cleanup_interval_hours = 24

[ticket_trash]
retention_days = 30
cleanup_interval_hours = 24

[scheduler]
sync_interval_seconds = 15

[session]
lifetime_minutes = 480
cookie_name = "ttms_session"
cookie_secure = false
cookie_samesite = "lax"

[auth]
login_window_seconds = 900
login_max_failures = 5
login_max_ip_failures = 30
csrf_lifetime_minutes = 30
# Set to the browser-facing origin when using an HTTPS reverse proxy.
# public_origin = "https://tasks.example.com"

[bootstrap]
organization_key = "default"
organization_name = "기본 조직"

[pagination]
default_size = 20
allowed_sizes = [10, 20, 50]

[backup]
retention_days = 30
max_archives = 10
